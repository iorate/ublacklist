{
  "name": "ublacklist",
  "version": "10.0.4",
  "private": true,
  "type": "module",
  "imports": {
    "#builtin/*": "./builtin/*"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "pnpm run /^check:/",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "e2e": "pnpm build --e2e && playwright test --config e2e/playwright.config.ts",
    "fix": "pnpm run /^fix:/",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "generate": "pnpm run /^generate:/",
    "generate:languages": "node scripts/generate-languages.ts",
    "generate:message-names": "node scripts/generate-message-names.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.10",
    "@lezer/highlight": "1.2.3",
    "@mdi/svg": "7.4.47",
    "@neodrag/vanilla": "2.3.1",
    "@sindresorhus/fnv1a": "3.1.0",
    "@ublacklist/match-pattern": "2.0.0",
    "@ublacklist/ruleset": "2.0.1",
    "@ublacklist/serpinfo": "3.0.0",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "css-tree": "3.2.1",
    "dayjs": "1.11.23",
    "es-toolkit": "1.52.0",
    "is-mobile": "5.0.0",
    "lz-string": "1.5.0",
    "punycode": "2.3.1",
    "react": "19.2.8",
    "react-colorful": "5.8.1",
    "react-dom": "19.2.8",
    "tldts": "7.4.11",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/css-tree": "3.2.0",
    "@types/fs-extra": "11.0.4",
    "@types/license-checker": "25.0.6",
    "@types/node": "24.13.3",
    "@types/punycode": "2.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/webextension-polyfill": "0.12.6",
    "chrome-types": "0.1.441",
    "csstype": "3.2.3",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "fs-extra": "11.4.0",
    "js-yaml": "5.4.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
