{
  "name": "ublacklist",
  "version": "10.1.2",
  "private": true,
  "type": "module",
  "imports": {
    "#builtin/*": "./builtin/*"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "pnpm run /^check:/",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "e2e": "pnpm build --e2e && playwright test --config e2e/playwright.config.ts",
    "fix": "pnpm run /^fix:/",
    "fix:lint": "oxlint --fix",
    "fix:format": "oxfmt",
    "generate": "pnpm run /^generate:/",
    "generate:languages": "node scripts/generate-languages.ts",
    "generate:message-names": "node scripts/generate-message-names.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@mdi/svg": "7.4.47",
    "@neodrag/vanilla": "2.3.1",
    "@sindresorhus/fnv1a": "3.1.0",
    "@ublacklist/match-pattern": "2.0.0",
    "@ublacklist/ruleset": "2.0.1",
    "@ublacklist/serpinfo": "3.0.0",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "css-tree": "3.2.1",
    "dayjs": "1.11.23",
    "es-toolkit": "1.53.0",
    "is-mobile": "5.0.0",
    "lz-string": "1.5.0",
    "punycode": "2.3.1",
    "react": "19.3.1",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.19",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/css-tree": "3.2.0",
    "@types/fs-extra": "11.0.4",
    "@types/license-checker": "25.0.6",
    "@types/node": "26.6.5",
    "@types/punycode": "2.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webextension-polyfill": "0.12.6",
    "chrome-types": "0.1.460",
    "csstype": "3.2.3",
    "dotenv": "18.0.9",
    "esbuild": "0.28.2",
    "fs-extra": "11.4.1",
    "js-yaml": "5.5.0",
    "lefthook": "2.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
