{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ublacklist/.github:renovate-config",
    ":pinAllExceptPeerDependencies"
  ],
  "git-submodules": {
    "enabled": true,
    "schedule": ["* * * * 4"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "matchManagers": ["git-submodules"],
      "matchDepNames": ["builtin"],
      "automerge": true
    }
  ]
}
