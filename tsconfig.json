{
  "include": ["src", "scripts", "e2e", "release"],

  "compilerOptions": {
    // Type Checking
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    // Modules
    "allowImportingTsExtensions": true,
    "module": "preserve",
    "types": ["*", "chrome-types"],

    // Emit
    "noEmit": true,

    // Interop Constraints
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // Language and Environment
    "jsx": "react-jsx",
    "target": "esnext",

    // Completeness
    "skipLibCheck": true
  }
}
